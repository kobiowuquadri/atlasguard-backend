  "info": {
    "title": "AtlasGuard API",
    "description": "Multilingual evaluation and reliability infrastructure for N-ATLaS (Yoruba, Hausa, Igbo, Nigerian English).\n\nAuthenticate with an API key (`Authorization: Bearer ag_…`, created in the dashboard) or a dashboard session cookie.\nSuccessful responses are wrapped as `{ \"success\": true, \"data\": … }`; errors as `{ \"success\": false, \"error\": { \"code\", \"message\", \"requestId\" } }`.\n\nN-ATLaS is an initiative of the Federal Ministry of Communications, Innovation and Digital Economy, and powered by Awarri Technologies.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "AtlasGuard API key (ag_…)"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ag_session"
      }
    },
    "schemas": {
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "SubmitFeedbackDto": {
        "type": "object",
        "properties": {}
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters.",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {}
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the AI application being evaluated.",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the AI application being evaluated.",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "ImportBenchmarkDto": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "object",
            "additionalProperties": true,
            "description": "A dataset in AtlasGuard benchmark format (formatVersion 1)."
          },
          "dryRun": {
            "type": "boolean",
            "description": "Validate only; nothing is saved."
          },
          "official": {
            "type": "boolean",
            "description": "Administrators only: import as an official AtlasGuard suite."
          }
        },
        "required": [
          "dataset"
        ]
      },
      "ReviewCaseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "REJECTED",
              "PENDING_REVIEW"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "attestation": {
            "type": "boolean",
            "description": "Required for VERIFIED: the reviewer confirms they are fluent in the case language and\nchecked the prompt, translation and reference facts."
          }
        },
        "required": [
          "status"
        ]
      },
      "InferenceParametersDto": {
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number",
            "description": "Sampling temperature; the N-ATLaS model card recommends 0.1.",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "number",
            "minimum": 16,
            "maximum": 2048
          },
          "topP": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
          },
          "repetitionPenalty": {
            "type": "number",
            "description": "The N-ATLaS model card recommends 1.12.",
            "minimum": 1,
            "maximum": 2
          },
          "seed": {
            "type": "number",
            "minimum": 0,
            "maximum": 2147483647
          },
          "systemPrompt": {
            "type": "string",
            "description": "Overrides the default system prompt. Send an empty string for no system prompt.",
            "maxLength": 2000
          }
        }
      },
      "CreateRunDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "suiteId": {
            "type": "string",
            "description": "Benchmark suite id.",
            "format": "uuid"
          },
          "languages": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "en-NG",
                "yo",
                "ha",
                "ig"
              ]
            }
          },
          "categories": {
            "type": "array",
            "description": "Restrict to these categories.",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "financial_terminology",
                "nigerian_english",
                "education",
                "civic_information",
                "cultural_context",
                "translation_meaning"
              ]
            }
          },
          "caseIds": {
            "description": "Run only these cases (ids from GET /benchmarks/:id/cases).",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "onlyVerified": {
            "type": "boolean",
            "description": "Only include cases whose content has been verified by a reviewer."
          },
          "modelConfigurationId": {
            "type": "string",
            "description": "Defaults to the system N-ATLaS configuration.",
            "format": "uuid"
          },
          "parameters": {
            "$ref": "#/components/schemas/InferenceParametersDto"
          }
        },
        "required": [
          "projectId",
          "suiteId",
          "languages"
        ]
      },
      "ReviewResultDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "decision"
        ]
      }
    }
  }
}
