# ---------------------------------------------------------------------------
# AtlasGuard API configuration. Copy to apps/api/.env and adjust.
# Never commit real secrets. Values marked REQUIRED IN PRODUCTION are validated at boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL. `pnpm db:start` (repo root) runs a local server on port 54329.
DATABASE_URL=postgresql://atlasguard:atlasguard@localhost:54329/atlasguard

# Browser origins allowed to call the API (comma-separated). The Next.js dashboard proxies
# /api/* to this server, so in most setups this is just the dashboard URL.
APP_ORIGINS=http://localhost:3000

# Set to true when running behind a reverse proxy / load balancer (Render, Railway, nginx).
TRUST_PROXY=false

# Sessions (HTTP-only cookie). COOKIE_SECURE defaults to true in production.
SESSION_COOKIE_NAME=ag_session
SESSION_TTL_HOURS=168
# COOKIE_SECURE=true

# Pepper for hashing API keys. REQUIRED IN PRODUCTION (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=

# Accounts registered with these emails become administrators (comma-separated).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# N-ATLaS inference endpoint (server-side only — never exposed to browsers)
# Point this at services/natlas-inference (or vLLM/TGI serving NCAIR1/N-ATLaS).
# ---------------------------------------------------------------------------
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_MODEL_ID=NCAIR1/N-ATLaS
# Hugging Face commit of the weights you serve (recorded on every run when set).
NATLAS_MODEL_REVISION=
# Other served-model names that refer to the same weights, e.g. a vLLM --served-model-name.
NATLAS_ACCEPTED_MODEL_NAMES=
NATLAS_TIMEOUT_MS=180000
NATLAS_MAX_RETRIES=2
NATLAS_MAX_CONCURRENCY=2
NATLAS_HEALTH_PATH=/health

# Development fixtures: SIMULATED responses for local work and tests. Defaults to enabled
# outside production. Fixture runs are labelled simulated and excluded from evidence exports.
# ENABLE_FIXTURE_PROVIDER=true
FIXTURE_DELAY_MS=400

# ---------------------------------------------------------------------------
# Evaluation worker (database-backed queue)
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
WORKER_STALE_AFTER_MS=120000
CASE_MAX_ATTEMPTS=3
MAX_CASES_PER_RUN=500

SWAGGER_ENABLED=true
LOG_LEVEL=info
